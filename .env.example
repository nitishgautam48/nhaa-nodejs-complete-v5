# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.

# Required for the authority dashboard to work at all. Officers/admins enter
# this code once when opening the dashboard; it also protects the underlying
# /api/v1/cases* endpoints directly (not just the page). Without it, the
# authority dashboard's data endpoints refuse every request (fail closed).
# Use a long, random value in any real deployment - do not use this example.
AUTHORITY_ACCESS_CODE=change-me-to-a-long-random-value

# Port the server listens on (optional, defaults to 8000).
PORT=8000
